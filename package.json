{
  "name": "parth-narula-portfolio",
  "private": true,
  "type": "module",
  "description": "Portfolio of Parth Narula (ScriptJacker). Static site, no build step needed to host it.",
  "scripts": {
    "images": "node tools/build-images.mjs",
    "globe": "node tools/build-globe.mjs",
    "vendor": "node tools/vendor.mjs",
    "serve": "npx --yes serve -l 4173 .",
    "assets": "node tools/build-assets.mjs",
    "cv": "node tools/cv/build.mjs",
    "cv:check": "python3 tools/cv/ats_check.py",
    "prerender": "node tools/prerender.mjs",
    "build": "npm run data && npm run images && npm run globe && npm run prerender && npm run assets && npm run stamp",
    "data": "node tools/sync-data.mjs",
    "stamp": "node tools/version.mjs",
    "test": "npm run test:html && npm run test:functional && npm run test:a11y",
    "test:functional": "node test/functional.mjs",
    "test:a11y": "node test/a11y.mjs",
    "test:html": "html-validate index.html gallery.html recognition.html 404.html"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "axe-core": "^4.14.1",
    "d3-geo": "^3.1.1",
    "html-validate": "^11.21.1",
    "playwright": "^1.56.1",
    "sharp": "^0.34.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
